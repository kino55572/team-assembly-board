# Скопируйте в .env и при необходимости измените. Секретов в демоверсии нет.
# Порт на 127.0.0.1, на котором открывается доска.
APP_PORT=8205
# 1 — показывать демо-входы на экране входа и разрешить /api/demo/reset. Для публичной версии — 0.
DEMO_MODE=1
# 1 — создать демо-набор при старте (повторный запуск не дублирует данные). Для публичной версии — 0.
SEED_DEMO=1
# 1 — cookie сессии только по HTTPS. Для публичной версии за HTTPS — 1.
COOKIE_SECURE=0
